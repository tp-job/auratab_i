{
  "manifest_version": 3,
  "name": "Atelier Launchpad",
  "version": "1.0.0",
  "description": "One-click launchpad: your most-used sites ranked by real usage, plus one search box for sites, bookmarks, history and the web.",
  "action": {
    "default_title": "Open Launchpad (Alt+Shift+L)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Open the launchpad"
    }
  },
  "permissions": ["history", "topSites", "bookmarks", "favicon", "storage", "search"]
}
